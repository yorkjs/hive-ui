.progress
  display flex
  align-items center
  position relative
  width 100%

.track
  flex auto
  position relative
  border-radius 6PX

.fill
  height 100%
  display flex
  flex-direction column
  justify-content center
  transition all 0.4s
  border-radius 6PX
  position relative

.shimmer
  content ''
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  border-radius 6PX
  animation shimmer 2s ease-in-out infinite

@keyframes shimmer
  0%
    background rgba(255, 255, 255, 0.1)
    width 0
  20%
    background rgba(255, 255, 255, 0.5)
    width 0
  100%
    background rgba(255, 255, 255, 0)
    width 100%

.text
  display flex
  align-items center
  position absolute
  top 50%
  transform translateY(-50%)
  transition all 0.4s

.textOutside
  display flex
  align-items center
  margin-left 8PX

.textInner
  display flex
  align-items center
  padding 4PX 10PX
  font-size 12PX
  line-height 1
  color #fff
  white-space nowrap
  border-radius 20PX
