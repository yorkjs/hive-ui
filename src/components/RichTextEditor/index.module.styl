@import '../../styles/mixin.styl'
@import '../../styles/variable.styl'

.rich-text-editor
  display flex
  flex-direction column
  gap 15PX

  :global
    taro-textarea-core
      width 100%
      .auto-height
        height auto
        background-color transparent

  .block
    position relative
    border-radius 10PX
    halfBorder(top right bottom left, var(--lineBorder), 20PX)

    .delete-btn
      position absolute
      top -6PX
      right -6PX
      z-index 2
      width 17PX
      height 17PX
      line-height 1
      flexHVCenter()

    .text-block
      background-color var(--containerCard)
      border-radius 10PX
      padding 15PX 15PX 6PX

      .textarea-wrap
        min-height 80PX

      .editor-textarea
        :global(.taro-textarea)
          width 100%
          font-size 14PX
          line-height 1.6
          color var(--textTitle)
          overflow hidden

        &.is-align-left
          :global(.taro-textarea)
            text-align left !important
        &.is-align-center
          :global(.taro-textarea)
            text-align center !important
        &.is-align-right
          :global(.taro-textarea)
            text-align right !important

      .align-toolbar
        display flex
        justify-content flex-end
        align-items center
        gap 12PX
        margin-top 4PX

        .align-btn
          padding 4PX
          flexHVCenter()
          &.is-disabled
            opacity 0.4
            pointer-events none

    .image-block
      overflow hidden
      border-radius 10PX
      background-color var(--containerCard)
      user-select none

      .image
        display block
        width 100%
        height auto
        pointer-events none
        user-select none
        -webkit-user-drag none
