@import '../../styles/mixin.styl'
@import '../../styles/variable.styl'

.rich-text-editor
  display flex
  flex-direction column
  gap 15PX

  :global
    taro-textarea-core
      width 100%
      .auto-height
        height auto
        min-height 80PX
        background-color transparent

  .block
    position relative
    border-radius 10PX
    halfBorder(top right bottom left, var(--lineBorder), 10PX)

    .delete-btn
      position absolute
      top -6PX
      right -6PX
      width 16PX
      height 16PX
      line-height 16PX
      text-align center
      border-radius 50%
      z-index 2

      .delete-icon
        position absolute
        top 50%
        left 50%
        transform translate(-50%, -50%)
        line-height 1
        display block

    .text-block
      padding 15PX 15PX 6PX

      .editor-textarea
        :global(.taro-textarea)
          width 100%
          font-size 14PX
          line-height 1.6
          color var(--textTitle)

        &.is-align-left
          :global(.taro-textarea)
            text-align left !important
        &.is-align-center
          :global(.taro-textarea)
            text-align center !important
        &.is-align-right
          :global(.taro-textarea)
            text-align right !important

      .align-toolbar
        display flex
        justify-content flex-end
        align-items center
        gap 12PX
        margin-top 4PX

        .align-btn
          padding 4PX
          flexHVCenter()

    .image-block
      overflow hidden
      border-radius 10PX

      .image
        display block
        width 100%
        height auto
