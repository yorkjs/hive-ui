@import '../../styles/mixin.styl'
@import '../../styles/variable.styl'

.stats-card
  padding 15PX 12PX
  background-color var(--containerCard)
  margin-left $WING_BLANK
  margin-right $WING_BLANK
  border-radius 10PX
  box-sizing border-box

  &.show-top-gutter
    margin-top $GUTTER_BLANK

  &.show-bottom-gutter
    margin-bottom $GUTTER_BLANK

  .card-title
    margin-bottom 16PX
    font-size 16PX
    font-weight bold
    color var(--textTitle)
    line-height 22PX
    lineClamp(1)

  .stats-row
    display flex
    align-items center
    justify-content space-between

  .stat-item
    display flex
    flex 1
    flex-direction column
    align-items center
    min-width 0

  .stat-value
    font-size 14PX
    font-weight bold
    color var(--primary)
    line-height 20PX

  .stat-label
    margin-top 5PX
    font-size 12PX
    color var(--textContent)
    line-height 17PX
    lineClamp(1)

  .stat-divider
    width 1PX
    height 38PX
    flex-shrink 0
    halfBorder(left, var(--lineBorder))
